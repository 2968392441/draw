          <mxGeometry height="30" width="275" x="1730" y="1580" as="geometry" />
        </mxCell>
        <mxCell id="n7_KqxkKyjz-61dVo68T-158" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;确立邓小平理论为党的指导思想&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="250" x="1710" y="1540" as="geometry" />
        </mxCell>
        <mxCell id="n7_KqxkKyjz-61dVo68T-159" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;明确提出我国经济体制改革的目标是建立社会主义市场经济体制&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="410" x="1730" y="1500" as="geometry" />
        </mxCell>
        <mxCell id="n7_KqxkKyjz-61dVo68T-160" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;深刻阐述社会主义本质，提出计划和市场都是经济手段，强调发展才是硬道理&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="550" x="1700" y="1460" as="geometry" />
        </mxCell>
        <mxCell id="n7_KqxkKyjz-61dVo68T-161" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;系统阐述社会主义初级阶段理论，提出党在社会主义初级阶段的基本路线：一个中心、两个基本点&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="625" x="1725" y="1420" as="geometry" />
        </mxCell>
        <mxCell id="n7_KqxkKyjz-61dVo68T-162" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;span style=&quot;font-size: 14px; white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;邓小平明确提出建设有中国特色的社会主义这一重大命题&lt;/span&gt;" vertex="1">
          <mxGeometry height="30" width="380" x="1710" y="1380" as="geometry" />
        </mxCell>
        <mxCell id="n7_KqxkKyjz-61dVo68T-163" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;通过《关于若干历史问题的决议》，标志整风运动胜利结束&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="370" x="1730" y="1010" as="geometry" />
        </mxCell>
        <mxCell id="n7_KqxkKyjz-61dVo68T-164" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;1945年六届七中全会&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="180" x="1500" y="1010" as="geometry" />
        </mxCell>
        <mxCell id="n7_KqxkKyjz-61dVo68T-165" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;通过《关于建国以来党的若干历史问题的决议》&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="305" x="1730" y="1310" as="geometry" />
        </mxCell>
        <mxCell id="n7_KqxkKyjz-61dVo68T-166" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;确立解放思想、实事求是的思想路线，&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;把工作重心转移到经济建设上来，作出改革开放的历史性决策。&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="500" x="1680" y="1260" as="geometry" />
        </mxCell>
        <mxCell id="n7_KqxkKyjz-61dVo68T-167" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;提出集中力量发展社会生产力、把我国由落后的农业国变为先进的工业国。&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="510" x="1710" y="1225" as="geometry" />
        </mxCell>
        <mxCell id="n7_KqxkKyjz-61dVo68T-168" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;提出争取国家财政经济状况基本好转的任务，强调不要四面出击&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="460" x="1700" y="1190" as="geometry" />
        </mxCell>
        <mxCell id="n7_KqxkKyjz-61dVo68T-169" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;标志着新民主主义革命基本胜利，&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;中国进入由新民主主义向社会主义过渡的时期&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="295" x="1730" y="1140" as="geometry" />
        </mxCell>
        <mxCell id="n7_KqxkKyjz-61dVo68T-170" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;决定把党的工作重心由乡村转移到城市，提出“两个务必”&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="360" x="1730" y="1090" as="geometry" />
        </mxCell>
        <mxCell id="n7_KqxkKyjz-61dVo68T-171" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;确立毛泽东思想为党的指导思想并写入党章&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="320" x="1710" y="1050" as="geometry" />
        </mxCell>
